#compdef wt wtcd
# Completion for wt. The workspace list comes from `wt ls -q` rather than
# from a hard-coded table, so only the verb list can ever drift from the
# tool; `wt help` is the place to check it against.

_wt_workspaces() {
  local -a found
  found=(${(f)"$(wt ls -q 2>/dev/null)"})
  (( $#found )) && _describe -t workspaces 'workspace' found
}

# True while the workspace has not been named yet in the words from $1 on, so
# it is still what to complete. wt's own launch options may be typed either
# side of it, and `--` hands everything after it to the agent, which wt knows
# nothing about.
_wt_launch_pending() {
  local index skip=0
  for (( index = $1; index < CURRENT; index++ )); do
    if (( skip )); then
      skip=0
      continue
    fi
    case ${words[index]} in
      --) return 1 ;;
      --seed|--seed-file|-b|--branch|-r|--clone|--relay) skip=1 ;;
      -*) ;;
      *) return 1 ;;
    esac
  done
  return 0
}

_wt_launch() {
  local -a launch_options
  launch_options=(
    '--new:start a fresh session instead of resuming the last one'
    '--branch:work on this branch instead of the derived one'
    '--clone:clone owner/repo, a URL or a path into the workspace'
    '--relay:open a relay turn from <owner>/<repo>@<brief sha>'
    '--seed:open the agent with this prompt'
    '--seed-file:read that prompt from a file, or - for stdin'
  )
  case ${words[CURRENT-1]} in
    --seed-file) _files; return ;;
    --seed) _message 'seed prompt'; return ;;
    -b|--branch) _message 'branch name'; return ;;
    -r|--clone) _message 'owner/repo, a URL, or a path'; return ;;
    --relay) _message '<owner>/<repo>@<brief sha>'; return ;;
  esac
  local separator=${words[(I)--]}
  if (( separator && separator < CURRENT )); then
    # Past `--` every word is the agent's, and wt has nothing to say.
    _default
    return
  fi
  if [[ ${words[CURRENT]} == -* ]]; then
    _describe -t options 'launch option' launch_options
    return
  fi
  _wt_launch_pending $1 && _wt_workspaces
}

_wt() {
  local -a verbs
  verbs=(
    'ls:list workspaces and the repos they hold'
    'new:create a workspace without launching an agent'
    'path:print a workspace directory'
    'pwd:print the root of the workspace you are in'
    'clone:clone a repository into a workspace'
    'branch:print the workspace branch'
    'git:run git in every repo of the workspace'
    'exec:run any command in every repo'
    'status:per-repo branch, upstream, cleanliness'
    'log:the commits of this line of work'
    'fetch:git fetch --prune in every repo'
    'sync:fetch, then rebase onto the default branch'
    'push:publish the workspace branch where there is work'
    'agents:show the agents running right now'
    'check:sanity-check the environment and layout'
    'tidy:delete .scratch and Git-ignored files'
    'sweep:remove workspaces whose work is all pushed'
    'rm:remove a workspace holding no unsaved work'
    'help:show the usage message'
    'claude:launch claude in a workspace'
    'codex:launch codex in a workspace'
    'droid:launch droid in a workspace'
  )

  if (( CURRENT == 2 )); then
    # A bare slug is a launch, so both are valid here. Completing the
    # workspaces is the point: it is the cheapest guard against a typo
    # quietly creating a second workspace and starting an agent in it.
    _describe -t verbs 'verb' verbs
    _wt_workspaces
    return
  fi

  case ${words[2]} in
    claude|codex|droid)
      _wt_launch 3
      ;;
    --new|--seed|--seed-file|-b|--branch|-r|--clone|--relay|\
    --seed=*|--seed-file=*|--branch=*|--clone=*|--relay=*)
      # A leading launch option is a launch under $WT_AGENT that has not
      # reached its workspace yet.
      _wt_launch 2
      ;;
    new)
      if [[ ${words[CURRENT-1]} == (-b|--branch) ]]; then
        _message 'branch name'
      elif [[ ${words[CURRENT-1]} == (-r|--clone) ]]; then
        _message 'owner/repo, a URL, or a path'
      else
        _wt_launch_pending 3 && _wt_workspaces
      fi
      ;;
    path|branch|status|log|fetch|sync|push|tidy|sweep|rm)
      (( CURRENT == 3 )) && _wt_workspaces
      ;;
    git|exec|clone)
      # -w names the workspace for the verbs whose own arguments look like
      # one; everything else is the command or the repository.
      if [[ ${words[CURRENT-1]} == (-w|--workspace) ]]; then
        _wt_workspaces
      elif [[ ${words[CURRENT-1]} == (-o|--owner) ]]; then
        _message 'owner directory'
      elif [[ ${words[CURRENT-1]} == (-b|--branch) ]]; then
        _message 'branch name'
      else
        _default
      fi
      ;;
    *)
      # A bare slug is a launch too, so its options complete the same way.
      _wt_launch 2
      ;;
  esac
}

_wtcd() {
  _wt_workspaces
}

case ${service} in
  wtcd) _wtcd "$@" ;;
  *) _wt "$@" ;;
esac
