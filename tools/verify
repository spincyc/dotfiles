#!/usr/bin/env python3

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


REPO_ROOT = Path(__file__).resolve().parent.parent
BOOTSTRAP_PATH = REPO_ROOT / "AI_GUIDANCE.md"
BOOTSTRAP_WARNING_WORDS = 225
BOOTSTRAP_MAX_WORDS = 250


def run(command: list[str], *, env: dict[str, str] | None = None) -> str:
    result = subprocess.run(
        command,
        cwd=REPO_ROOT,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if result.returncode:
        output = result.stdout.strip()
        raise RuntimeError(
            f"command failed ({result.returncode}): {' '.join(command)}"
            + (f"\n{output}" if output else "")
        )
    return result.stdout


def check_arch_packages() -> None:
    lines = (REPO_ROOT / "Makefile").read_text().splitlines()
    start = lines.index("ARCH_PACKAGES := \\")
    package_lines: list[str] = []

    for line in lines[start + 1 :]:
        if not line.startswith("  "):
            break
        package_lines.append(line)

    if not package_lines:
        raise RuntimeError("ARCH_PACKAGES must contain at least one package")

    packages: list[str] = []
    for index, line in enumerate(package_lines):
        is_last = index == len(package_lines) - 1
        expected = r"  ([a-z0-9][a-z0-9@._+-]*)" + (r" \\" if not is_last else "")
        match = re.fullmatch(expected, line)
        if not match:
            raise RuntimeError(
                "list each Arch package on its own line in ARCH_PACKAGES"
            )
        packages.append(match.group(1))

    if packages != sorted(set(packages)):
        raise RuntimeError("ARCH_PACKAGES must be sorted and contain no duplicates")


def check_bootstrap_budget() -> None:
    word_count = len(BOOTSTRAP_PATH.read_text().split())
    if word_count > BOOTSTRAP_MAX_WORDS:
        raise RuntimeError(
            f"{BOOTSTRAP_PATH.name} has {word_count} words; "
            f"maximum is {BOOTSTRAP_MAX_WORDS}"
        )
    if word_count >= BOOTSTRAP_WARNING_WORDS:
        raise RuntimeError(
            f"{BOOTSTRAP_PATH.name} has {word_count} words; "
            "discuss simplification before changing it further"
        )


def check_tracked_paths() -> None:
    tracked = [path for path in run(["git", "ls-files", "-z"]).split("\0") if path]
    forbidden = [path for path in tracked if path.endswith(".sqlite3")]
    for path in tracked:
        try:
            with open(REPO_ROOT / path, "rb") as handle:
                first_line = handle.readline(512)
        except OSError:
            continue
        if b"aiq-journal-jsonl" in first_line:
            forbidden.append(path)
    if forbidden:
        raise RuntimeError(
            f"journal artifacts are tracked: {', '.join(sorted(set(forbidden)))}"
        )


def check_bootstrap_files() -> None:
    entry_points = [
        "AGENTS.md",
        "CLAUDE.md",
        "GEMINI.md",
        ".github/copilot-instructions.md",
    ]
    for name in entry_points:
        path = REPO_ROOT / name
        if not path.is_file():
            raise RuntimeError(f"bootstrap entry point is missing: {name}")
        text = path.read_text()
        if "AI_GUIDANCE.md" not in text:
            raise RuntimeError(f"{name} does not link AI_GUIDANCE.md")
        word_count = len(text.split())
        if word_count > 60:
            raise RuntimeError(
                f"{name} has {word_count} words; bootstrap files stay under 60"
            )


def check_guidance_crossrefs() -> None:
    tracked = {
        path.split("/", 1)[1]
        for path in run(["git", "ls-files", "-z", "--", "ai-guidance"]).split("\0")
        if path.endswith(".md")
    }
    sources = [REPO_ROOT / "AI_GUIDANCE.md"] + sorted(
        (REPO_ROOT / "ai-guidance").glob("*.md")
    )
    for source in sources:
        for ref in re.findall(r"\b(\d{2}-[a-z-]+\.md)\b", source.read_text()):
            if ref not in tracked:
                raise RuntimeError(
                    f"{source.name} references untracked document {ref}"
                )


def check_guidance_index() -> None:
    tracked = sorted(
        path.split("/", 1)[1]
        for path in run(["git", "ls-files", "-z", "--", "ai-guidance"]).split("\0")
        if path.endswith(".md")
    )
    entries = re.findall(
        r"^(\d+)\. \[`([^`]+)`\]\(ai-guidance/([^)]+)\)(.*?)(?=^\d+\. |\n\n)",
        BOOTSTRAP_PATH.read_text(),
        flags=re.MULTILINE | re.DOTALL,
    )
    listed = [entry[1] for entry in entries]

    for number, name, target, scope in entries:
        if name != target:
            raise RuntimeError(f"index entry {name} links to {target}")
        if "—" not in scope:
            raise RuntimeError(f"index entry {name} lacks a scope annotation")
    if [int(entry[0]) for entry in entries] != list(range(1, len(entries) + 1)):
        raise RuntimeError("index entries are not numbered sequentially")
    if listed != sorted(listed):
        raise RuntimeError("index entries are not in numeric-prefix order")
    if listed != tracked:
        missing = set(tracked) - set(listed)
        extra = set(listed) - set(tracked)
        raise RuntimeError(
            "index and tracked ai-guidance files differ: "
            f"unlisted={sorted(missing)} untracked={sorted(extra)}"
        )


def check_core_recovery_contract() -> None:
    text = (REPO_ROOT / "ai-guidance" / "00-core.md").read_text()
    required = [
        "status question during active work",
        "not as cancellation or supersession",
        "durable identifiers, process state, and artifacts",
        "Never launch a duplicate",
        "unknown outcome or unproved teardown is neither completion",
    ]
    missing = [phrase for phrase in required if phrase not in text]
    if missing:
        raise RuntimeError(
            "00-core.md lacks recovery guarantees: " + ", ".join(missing)
        )


def check_relay_protocol() -> None:
    # Overridable so the test can exercise the failing path on a stand-in file.
    override = os.environ.get("RELAY_PROTOCOL_PATH")
    path = Path(override) if override else REPO_ROOT / "relay" / "PROTOCOL.md"
    if not path.is_file():
        raise RuntimeError(f"{path} is missing")
    text = path.read_text()
    required_sections = [
        "Roles",
        "Authorization",
        "Preconditions",
        "Channel layout",
        "Turn file format",
        "Handoff line",
        "Context boundary",
        "Turn allocation and the single-writer rule",
        "Planner rules",
        "Executor rules",
        "Blocked channel",
        "Recovery",
    ]
    headings = re.findall(r"^## (.+)$", text, flags=re.MULTILINE)
    missing = [name for name in required_sections if name not in headings]
    if missing:
        raise RuntimeError(f"{path.name} lacks sections: " + ", ".join(missing))
    if not re.search(r"^Version `relay-v\d+`\.$", text, flags=re.MULTILINE):
        raise RuntimeError(f"{path.name} does not declare a protocol version")


def check_tool_registry() -> None:
    if not (REPO_ROOT / "tmt.json").exists():
        return
    tmt = shutil.which("tmt") or str(Path.home() / ".local" / "bin" / "tmt")
    if not os.access(tmt, os.X_OK):
        print("skip check_tool_registry: tmt unavailable")
        return
    run([tmt, "check"])


def check_python_modules() -> None:
    run([sys.executable, "-m", "compileall", "-q", "python", "bin/wt"])
    for cache in (REPO_ROOT / "python").rglob("__pycache__"):
        shutil.rmtree(cache, ignore_errors=True)


def check_wt() -> None:
    run(["sh", "-n", "tests/wt.sh"])
    run(["./tests/wt.sh"])


def check_wt_unit() -> None:
    run([sys.executable, "tests/wt_unit.py"])


def check_profile() -> None:
    run(["git", "diff", "--check", "HEAD"])
    run(["sh", "-n", "install.sh"])
    run(["zsh", "-n", ".zshenv"])
    run(["zsh", "-n", ".zshrc"])
    for completion in sorted(Path("zsh").glob("_*")):
        run(["zsh", "-n", str(completion)])

    tmux_socket = f"dotfiles-check-{os.getpid()}"
    run(
        [
            "tmux",
            "-L",
            tmux_socket,
            "-f",
            str(REPO_ROOT / ".tmux.conf"),
            "new-session",
            "-d",
        ]
    )
    try:
        run(["tmux", "-L", tmux_socket, "kill-server"])
    except RuntimeError:
        pass

    repository_bin = str(REPO_ROOT / "bin")
    with tempfile.TemporaryDirectory() as install_home:
        install_env = os.environ.copy()
        install_env["HOME"] = install_home
        # Drop the entry from the inherited PATH so the check proves .zshenv
        # added it rather than that this process already had it.
        install_env["PATH"] = ":".join(
            entry
            for entry in install_env.get("PATH", "").split(":")
            if entry and entry != repository_bin
        )
        run(["./install.sh"], env=install_env)
        run(["./install.sh", "--check"], env=install_env)

        shell_path = run(
            ["zsh", "-c", "print -r -- $PATH"], env=install_env
        ).strip()
        if repository_bin not in shell_path.split(":"):
            raise RuntimeError(
                f".zshenv did not put {repository_bin} on PATH; "
                "the symlink self-resolution may be broken"
            )


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in ("--help", "-h"):
        print("Usage: tools/verify [--only CHECK ...]")
        print("Run the repository verification battery; see the Makefile.")
        print("CHECK names drop the check_ prefix, e.g. --only guidance_index")
        return 0
    checks = [
        check_arch_packages,
        check_bootstrap_budget,
        check_bootstrap_files,
        check_guidance_crossrefs,
        check_guidance_index,
        check_core_recovery_contract,
        check_relay_protocol,
        check_tool_registry,
        check_tracked_paths,
        check_python_modules,
        check_wt,
        check_wt_unit,
        check_profile,
    ]
    if len(sys.argv) > 2 and sys.argv[1] == "--only":
        wanted = set(sys.argv[2:])
        by_name = {check.__name__.removeprefix("check_"): check for check in checks}
        unknown = wanted - by_name.keys()
        if unknown:
            print(f"FAIL unknown checks: {', '.join(sorted(unknown))}")
            return 1
        checks = [by_name[name] for name in by_name if name in wanted]
    failures: list[str] = []

    for check in checks:
        try:
            check()
        except (RuntimeError, ValueError) as error:
            failures.append(f"{check.__name__}: {error}")

    if failures:
        for failure in failures:
            print(f"FAIL {failure}")
        return 1

    print("Verification passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
