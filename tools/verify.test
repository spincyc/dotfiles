#!/bin/sh
# Test for tools/verify: exit 0 = pass (the stable gate).
set -eu

tool="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/verify"

# --help always works.
"$tool" --help >/dev/null

# Check selection runs a cheap subset and passes on the current tree.
"$tool" --only bootstrap_budget guidance_index bootstrap_files \
  guidance_crossrefs core_recovery_contract relay_protocol >/dev/null

# Unknown check names fail with a diagnostic.
if "$tool" --only no_such_check >/dev/null 2>&1; then
  echo "expected unknown check to fail" >&2
  exit 1
fi

# The relay contract check actually fails on a document missing a section.
stand_in="$(mktemp)"
trap 'rm -f -- "$stand_in"' EXIT
printf 'Version `relay-v1`.\n\n## Roles\n' >"$stand_in"
if RELAY_PROTOCOL_PATH="$stand_in" "$tool" --only relay_protocol >/dev/null 2>&1
then
  echo "expected relay_protocol to fail on an incomplete document" >&2
  exit 1
fi

# And on a document with every section but no version declaration.
printf '## %s\n' Roles Authorization Preconditions \
  "Workspace initialization" "Channel layout" \
  "Turn file format" "Handoff line" "Context boundary" \
  "Turn allocation and the single-writer rule" "Planner rules" \
  "Executor rules" "Final sync" "Blocked channel" Recovery >"$stand_in"
if RELAY_PROTOCOL_PATH="$stand_in" "$tool" --only relay_protocol >/dev/null 2>&1
then
  echo "expected relay_protocol to fail without a version declaration" >&2
  exit 1
fi

# And on a structurally complete document missing required execution settings.
{
  printf 'Version `relay-v5`.\n'
  printf '## %s\n' Roles Authorization Preconditions \
    "Workspace initialization" "Channel layout" \
    "Turn file format" "Seed briefs" "Handoff line" "Context boundary" \
    "Turn allocation and the single-writer rule" "Planner rules" \
    "Executor rules" "Final sync" "Blocked channel" Recovery
} >"$stand_in"
if RELAY_PROTOCOL_PATH="$stand_in" "$tool" --only relay_protocol >/dev/null 2>&1
then
  echo "expected relay_protocol to fail without required execution settings" >&2
  exit 1
fi

# A declared version must match the front matter, URL, and handoff example.
sed 's/^protocol: relay-v5$/protocol: relay-v4/' \
  "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/relay/PROTOCOL.md" \
  >"$stand_in"
if RELAY_PROTOCOL_PATH="$stand_in" "$tool" --only relay_protocol >/dev/null 2>&1
then
  echo "expected relay_protocol to fail on inconsistent version uses" >&2
  exit 1
fi

# The clean-checkout branch bootstrap is part of the durable relay contract.
sed '/`git switch --track origin\/<branch>`/d' \
  "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/relay/PROTOCOL.md" \
  >"$stand_in"
if RELAY_PROTOCOL_PATH="$stand_in" "$tool" --only relay_protocol >/dev/null 2>&1
then
  echo "expected relay_protocol to fail without branch initialization" >&2
  exit 1
fi

# So is the merge-preserving final sync that replaced a mandatory rebase.
sed '/`git rebase --rebase-merges origin\/<branch>`/d' \
  "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/relay/PROTOCOL.md" \
  >"$stand_in"
if RELAY_PROTOCOL_PATH="$stand_in" "$tool" --only relay_protocol >/dev/null 2>&1
then
  echo "expected relay_protocol to fail without the final-sync rule" >&2
  exit 1
fi
