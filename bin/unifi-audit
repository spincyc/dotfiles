#!/usr/bin/env python3
"""Report the UniFi Network settings that shape Wi-Fi stability.

A controller holds the answer to most "why is the Wi-Fi bad" questions, but
the fields that matter are spread across four endpoints and several UI
screens, so a by-hand pass misses things. This command reads all four in one
go, marks the fields worth a second look with `!!`, and can print or save
every key so a later comparison has something to diff against.

Environment:
    UNIFI_HOST      console host, IP, or URL          (required)
    UNIFI_API_KEY   API key                           (required)
    UNIFI_SITE      site name                         (default: "default")

The key comes from Settings -> Control Plane -> Integrations -> API Keys. It
is read from the environment and never written to the output, so a saved
report can be shared as-is.

UniFi OS serves the controller under /proxy/network; older standalone
controllers serve it at the root. Both layouts are tried, in that order.
"""

import argparse
import json
import os
import ssl
import sys
import urllib.error
import urllib.request

ENDPOINTS = ("rest/wlanconf", "rest/device", "get/setting", "stat/device")


def _true(value):
    return value is True


def _false(value):
    return value is False


def _set(value):
    return bool(value) and value not in (0, "0")


def _short_rekey(value):
    try:
        return _set(value) and int(value) < 600
    except (TypeError, ValueError):
        return False


def _narrow(value):
    return str(value) in ("20", "40")


# Each row is (field, flag_predicate_or_None, explanation). A row whose
# predicate returns True is printed with `!!`; the rest are context.
WLAN_FIELDS = (
    ("enabled", None, "SSID enabled"),
    ("mesh_sta_vap_enabled", _true, "SSID may ride wireless mesh uplinks"),
    ("fast_roaming_enabled", _true, "802.11r fast transition"),
    ("bss_transition", _true, "802.11v BSS transition"),
    ("rrm_enabled", _false, "802.11k off, so clients scan blind"),
    ("minimum_rssi_enabled", _true, "minimum RSSI disconnects clients"),
    ("minimum_rssi", None, "minimum RSSI threshold (dBm)"),
    ("group_rekey", _short_rekey, "GTK rekey interval (seconds)"),
    ("dtim_mode", None, "DTIM mode"),
    ("dtim_ng", None, "DTIM period, 2.4 GHz"),
    ("dtim_na", None, "DTIM period, 5 GHz"),
    ("bc_filter_enabled", _false, "broadcast filtering off"),
    ("mcastenhance_enabled", _false, "multicast enhancement off"),
    ("no2ghz_oui", None, "band steering away from 2.4 GHz"),
    ("uapsd_enabled", _true, "U-APSD client power save"),
    ("pmf_mode", None, "protected management frames"),
    ("wpa_mode", None, "WPA mode"),
    ("security", None, "security"),
    ("wlan_bands", None, "bands this SSID uses"),
    ("hide_ssid", _true, "hidden SSID forces clients to probe actively"),
)

RADIO_FIELDS = (
    ("channel", None, "channel"),
    ("ht", _narrow, "channel width, narrow caps throughput"),
    ("tx_power_mode", None, "transmit power mode"),
    ("tx_power", None, "transmit power"),
    ("min_rssi_enabled", _true, "per-radio minimum RSSI"),
    ("min_rssi", None, "per-radio minimum RSSI value"),
    ("channel_optimization_enabled", _true, "automatic channel optimization"),
    ("sens_level_enabled", _true, "sensitivity threshold override"),
    ("hard_noise_floor", None, "noise floor override"),
)

DEVICE_FIELDS = (
    ("model", None, "model"),
    ("version", None, "firmware"),
    ("atf_enabled", None, "airtime fairness"),
    ("bandsteering_mode", None, "band steering mode"),
    ("mesh_uplink_1", _set, "mesh uplink configured"),
    ("mesh_uplink_2", _set, "mesh uplink configured"),
    ("meshv3_peer_mac", _set, "mesh peer pinned"),
)

# Site-wide blocks worth printing in full; --all prints the rest too.
SETTING_KEYS = {
    "connectivity": "uplink connectivity monitor",
    "mgmt": "management and advanced features",
    "auto_speedtest": "scheduled speed tests",
    "radio_ai": "RF auto-optimization",
    "wifiman": "WiFiman",
}


def fetch(base, site, path, key, context):
    """Return the decoded `data` for one endpoint, trying both URL layouts."""
    failure = "no attempt made"
    for prefix in ("/proxy/network/api/s/", "/api/s/"):
        url = f"{base}{prefix}{site}/{path}"
        request = urllib.request.Request(
            url, headers={"X-API-Key": key, "Accept": "application/json"})
        try:
            with urllib.request.urlopen(request, timeout=20,
                                        context=context) as response:
                body = json.loads(response.read().decode())
                return body.get("data", body), url
        except urllib.error.HTTPError as error:
            if error.code in (401, 403):
                raise SystemExit(
                    f"authentication failed ({error.code}) for {url}; "
                    "check UNIFI_API_KEY and that the key has read access")
            failure = f"HTTP {error.code}"
        except (urllib.error.URLError, ValueError, OSError) as error:
            failure = str(error)
    raise SystemExit(f"could not read {path} from {base}: {failure}")


def report(fields, record, indent):
    for name, flagged, explanation in fields:
        if name not in record:
            continue
        value = record[name]
        mark = "!!" if flagged and flagged(value) else "  "
        print(f"{indent}{mark} {name:<30} = {value!r:<22} {explanation}")


def dump_all(record, indent, skip=()):
    print(f"{indent}-- all keys --")
    for name in sorted(record):
        if name not in skip:
            print(f"{indent}   {name} = {record[name]!r}")


def build_context(verify):
    context = ssl.create_default_context()
    if not verify:
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        print("note: TLS verification is off because UniFi consoles ship "
              "self-signed certificates; pass --verify to require a valid one.",
              file=sys.stderr)
    return context


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--all", action="store_true",
                        help="also print every key of every record")
    parser.add_argument("--json", metavar="DIR",
                        help="save the raw JSON of each endpoint into DIR")
    parser.add_argument("--verify", action="store_true",
                        help="require a valid TLS certificate")
    args = parser.parse_args(argv)

    host = os.environ.get("UNIFI_HOST")
    key = os.environ.get("UNIFI_API_KEY")
    site = os.environ.get("UNIFI_SITE", "default")
    if not host or not key:
        raise SystemExit("set UNIFI_HOST and UNIFI_API_KEY; see --help")

    base = host if host.startswith("http") else f"https://{host}"
    base = base.rstrip("/")
    context = build_context(args.verify)

    data = {}
    for path in ENDPOINTS:
        data[path], url = fetch(base, site, path, key, context)
        print(f"read {url} ({len(data[path])} records)", file=sys.stderr)

    if args.json:
        os.makedirs(args.json, exist_ok=True)
        for path, records in data.items():
            target = os.path.join(args.json, path.replace("/", "_") + ".json")
            with open(target, "w") as handle:
                json.dump(records, handle, indent=2, sort_keys=True)
        print(f"raw JSON written to {args.json}", file=sys.stderr)

    print(f"\nUniFi audit for site {site!r}; '!!' marks a field worth review.")

    print("\n## Per-SSID (rest/wlanconf)")
    for wlan in data["rest/wlanconf"]:
        print(f"\n  SSID {wlan.get('name')!r}")
        report(WLAN_FIELDS, wlan, "    ")
        if args.all:
            dump_all(wlan, "    ")

    print("\n## Per-AP configuration (rest/device)")
    for device in data["rest/device"]:
        if device.get("type") != "uap":
            continue
        print(f"\n  AP {device.get('name')!r}")
        report(DEVICE_FIELDS, device, "    ")
        for radio in device.get("radio_table", ()):
            print(f"    radio {radio.get('radio')}:")
            report(RADIO_FIELDS, radio, "      ")
        if args.all:
            dump_all(device, "    ", skip=("radio_table",))

    print("\n## Live uplink and channel utilization (stat/device)")
    for device in data["stat/device"]:
        if device.get("type") != "uap":
            continue
        uplink = device.get("uplink") or {}
        kind = uplink.get("type", "unknown")
        mark = "  " if kind == "wire" else "!!"
        print(f"\n  {mark} AP {device.get('name')!r} uplink={kind} "
              f"speed={uplink.get('speed')} clients={device.get('num_sta')}")
        for stats in device.get("radio_table_stats", ()):
            total = stats.get("cu_total")
            busy = isinstance(total, (int, float)) and total > 50
            print(f"      {'!!' if busy else '  '} {stats.get('radio'):<4} "
                  f"utilization={total}% "
                  f"rx={stats.get('cu_self_rx')}% tx={stats.get('cu_self_tx')}% "
                  f"clients={stats.get('num_sta')}")

    print("\n## Site settings (get/setting)")
    for setting in data["get/setting"]:
        name = setting.get("key")
        if name not in SETTING_KEYS and not args.all:
            continue
        print(f"\n  [{name}] {SETTING_KEYS.get(name, '')}".rstrip())
        for field in sorted(setting):
            if field not in ("_id", "site_id", "key"):
                print(f"       {field} = {setting[field]!r}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
