{
  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{}",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ]
    }
  },
  "custom/ml4w-welcome": {
    "on-click": "qs ipc call sidebar toggle",
    "on-click-right": "qs ipc call welcome toggle",
    "format": "\uf2c0",
    "tooltip-format": "Left: Open ML4W Sidebar\nRight: Open ML4W Welcome App"
  },
  "custom/empty": {
    "format": ""
  },
  "custom/tools": {
    "format": "\uf5fd",
    "tooltip-format": "Tools",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/cliphist": {
    "format": "\uf0ea",
    "on-click": "sleep 0.1 && ~/.config/ml4w/scripts/ml4w-cliphist",
    "on-click-right": "sleep 0.1 && ~/.config/ml4w/scripts/ml4w-cliphist d",
    "on-click-middle": "sleep 0.1 && ~/.config/ml4w/scripts/ml4w-cliphist w",
    "tooltip-format": "Left: Open clipboard manager\nRight: Delete an entry\nMiddle: Clear list",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/updates": {
    "format": "\uf1b2 {}",
    "escape": true,
    "return-type": "json",
    "exec": "~/.config/ml4w/scripts/ml4w-check-system-updates",
    "interval": 1800,
    "signal": 1,
    "hide-empty-text": true,
    "on-click": "~/.config/ml4w/settings/installupdates.sh",
    "on-click-right": "~/.config/ml4w/settings/software.sh"
  },
  "custom/appmenu": {
    "format": "\uf009",
    "on-click": "~/.config/hypr/scripts/launcher.sh",
    "on-click-right": "~/.config/hypr/scripts/keybindings.sh",
    "tooltip-format": "Left: Open the application launcher\nRight: Show all keybindings"
  },
  "custom/exit": {
    "format": "\uf011",
    "on-click": "qs ipc call power toggle",
    "tooltip-format": "Open Power Menu"
  },
  "custom/notification": {
    "tooltip-format": "Left: Notifications\nRight: Do not disturb",
    "format": "{icon}",
    "format-icons": {
      "notification": "notifications_active",
      "none": "notifications",
      "dnd-notification": "notifications_active",
      "dnd-none": "notifications_paused",
      "inhibited-notification": "notification_important",
      "inhibited-none": "notification_important",
      "dnd-inhibited-notification": "do_not_disturb_on",
      "dnd-inhibited-none": "notifications_off"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/hyprshade": {
    "format": "\ue4dc",
    "tooltip-format": "Toggle Screen Shader",
    "on-click": "sleep 0.5; ~/.config/ml4w/scripts/ml4w-toggle-hyprsunset",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/hypridle": {
    "format": "\uf023",
    "return-type": "json",
    "escape": true,
    "exec-on-event": true,
    "interval": 60,
    "exec": "~/.config/hypr/scripts/hypridle.sh status",
    "on-click": "~/.config/hypr/scripts/hypridle.sh toggle",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 6
  },
  "clock": {
    "format": "{:%H:%M}",
    "on-click": "qs ipc call calendar toggle",
    "timezone": "",
    "tooltip": true,
    "tooltip-format": "{:%A\n%Y-%m-%d}"
  },
  "custom/system": {
    "format": "\ue473",
    "tooltip": false,
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "cpu": {
    "format": "C {usage}",
    "on-click": "~/.config/ml4w/settings/system-monitor.sh",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "memory": {
    "format": "M {}",
    "on-click": "~/.config/ml4w/settings/system-monitor.sh",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "disk": {
    "interval": 30,
    "format": "D {percentage_used}",
    "path": "/",
    "on-click": "~/.config/ml4w/settings/system-monitor.sh",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "hyprland/language": {
    "format": "K {short}",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "group/hardware": {
    "orientation": "vertical",
    "drawer": {
      "transition-duration": 300,
      "children-class": "not-memory",
      "transition-left-to-right": true
    },
    "modules": [
      "custom/system",
      "disk",
      "temperature",
      "cpu",
      "memory",
      "hyprland/language"
    ]
  },
  "group/tools": {
    "orientation": "vertical",
    "drawer": {
      "transition-duration": 300,
      "children-class": "not-memory",
      "transition-left-to-right": true
    },
    "modules": [
      "custom/tools",
      "custom/cliphist",
      "custom/hypridle",
      "custom/hyprshade",
      "power-profiles-daemon"
    ]
  },
  "network": {
    "format": "\uf6ff",
    "format-wifi": "\uf1eb {signalStrength}",
    "format-ethernet": "\uf796",
    "format-disconnected": "\uf127",
    "tooltip-format": "\uf796 {ifname} via {gwaddr}",
    "tooltip-format-wifi": "\uf1eb  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-ethernet": "\uf796 {ifname}\nIP: {ipaddr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "~/.config/ml4w/settings/networkmanager.sh",
    "on-click-right": "~/.config/ml4w/scripts/nm-applet.sh toggle"
  },
  "battery": {
    "interval": 1,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}",
    "format-charging": "\uf5e7 {capacity}",
    "format-plugged": "\uf1e6 {capacity}",
    "format-icons": [
      "\uf244",
      "\uf243",
      "\uf242",
      "\uf241",
      "\uf240"
    ],
    "tooltip": true,
    "tooltip-format": "{capacity}% - {time}"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "\uf185",
      "performance": "\uf0e7",
      "balanced": "\uf863",
      "power-saver": "\uf06c"
    },
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-bluetooth-muted": "\uf6a9",
    "format-muted": "\uf6a9",
    "format-source": "{volume}% \uf130",
    "format-source-muted": "\uf131",
    "format-icons": {
      "headphone": "\uf025",
      "hands-free": "\uf590",
      "headset": "\uf590",
      "phone": "\uf095",
      "portable": "\uf095",
      "car": "\uf1b9",
      "default": [
        "\uf026",
        "\uf027",
        "\uf028"
      ]
    },
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\n{desc}"
  },
  "bluetooth": {
    "format": "\uf293",
    "format-disabled": "\uf5b0",
    "format-off": "\uf5b0",
    "on-click": "sleep 0.1 && ~/.config/ml4w/settings/bluetooth.sh",
    "tooltip-format-connected": "Connected devices: {num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t| Battery life: {device_battery_percentage}%",
    "format-no-controller": "\uf5b0",
    "format-on": "\uf293",
    "format-connected": "\uf293 {num_connections}"
  },
  "backlight": {
    "format": "{icon} {percent}",
    "format-icons": [
      "\uf5df",
      "\uf5e0",
      "\uf5e1"
    ],
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%",
    "on-scroll-up": "brightnessctl -q s +5%",
    "on-scroll-down": "brightnessctl -q s 5%-"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 90,
    "format": "{icon} {temperatureC}",
    "format-icons": [
      "\uf2cb",
      "\uf2c9",
      "\uf2c7"
    ],
    "tooltip": true,
    "tooltip-format": "CPU package: {temperatureC}\u00b0C",
    "on-click": "~/.config/ml4w/settings/system-monitor.sh"
  },
  "mpris": {
    "format": "{status_icon}",
    "format-paused": "{status_icon}",
    "status-icons": {
      "playing": "\uf04b",
      "paused": "\uf04c",
      "stopped": "\uf04d"
    },
    "tooltip": true,
    "tooltip-format": "{title}\n{artist}",
    "title-len": 40,
    "artist-len": 30,
    "interval": 2
  },
  "privacy": {
    "icon-spacing": 2,
    "icon-size": 16,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 20
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 20
      }
    ]
  }
}
