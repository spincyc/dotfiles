{
  "description": "Persist user prompts in the local AI journal.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/libexec/aiq/codex-user-prompt-submit\"",
            "timeout": 10,
            "statusMessage": "Capturing message"
          }
        ]
      }
    ]
  }
}
